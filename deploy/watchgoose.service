[Unit]
# watchgoose — the dead-man's switch daemon.
#
# This unit starts a process. It does not fire anything. See "no timer" below
# before you "fix" that.
Description=watchgoose dead-man's switch daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/srv/watchgoose/watchgoose -config /etc/watchgoose.yaml
Restart=always
RestartSec=5
# A wedged stop would sit in the way of the reboot rung, so cap how long
# systemd waits for the main daemon to exit after SIGTERM.
TimeoutStopSec=10
# The escalation child must survive this unit stopping during a stalled reboot.
# It ignores SIGTERM and has a bounded lifetime. A new session does not move a
# process out of a systemd cgroup, so the default control-group kill mode would
# send it SIGKILL after TimeoutStopSec, before its five-minute deadline.
KillMode=process
# If the config is bad, the bind address is not up yet, or the binary is wrong,
# this loop is what recovers. It also means a genuinely bad config produces a
# restart every 5s in the journal rather than a single clean failure; that is the
# correct trade for a machine that may be unreachable.
#
# Runs as root, and this is not negotiable. Repair runs useradd/usermod and
# writes /etc/sudoers.d/; the forceful reboot rung writes /proc/sysrq-trigger
# (ADR 0002). There is no non-root identity on this
# machine that can do those things, and inventing one would add a way to be
# wrong without removing a way to be attacked. The daemon carries no
# authentication of any kind (ADR 0006), so the thing being defended against is
# not a local attacker.

#
# ─────────────────────────────────────────────────────────────────────────────
# NO TIMER. NO ExecStartPre. NO .timer FILE. THIS IS DELIBERATE.
#
# A single process listens for reassurance, decides whether the deadline has
# passed, and acts — by decision, recorded in docs/adr/0005-single-daemon.md.
# There is no separate decider, no cron entry, and no systemd timer, and adding
# one would reintroduce exactly the failure mode ADR 0005 exists to remove: two
# schedulers that can disagree about what the switch should do, and a
# dependency on systemd being healthy at the moment the switch has to act. A
# wedged PID 1 must not be able to stop this machine from noticing it is
# unreachable.
#
# If you are reading this because you expected a timer, that expectation is the
# bug. The reassurance deadline is enforced in-process, at
# server.poll_interval, and its only on-disk state is the timestamp of the last
# reassurance.
# ─────────────────────────────────────────────────────────────────────────────
#

# Modest hardening, limited to what cannot break repair.
NoNewPrivileges=true
PrivateTmp=true
# Account repair writes /etc/passwd, /etc/shadow and /etc/sudoers.d. Even
# ProtectSystem=full makes /etc read-only, so it would disable repair.
ProtectSystem=true
# Explicitly FALSE, and it must stay false.
#
# ProtectHome=true would hide /home from the daemon. The volume holding the
# ordinary accounts' homes is a separate disk that intermittently fails to
# mount, and repair of those accounts is exactly the thing that has to work when
# everything else has not (ADR 0004). A daemon that cannot see /home repairs
# nobody, and reports having done so.
ProtectHome=false

# ── Omitted on purpose. Each of these looks like free hardening and each one
# ── breaks a rung of the reboot ladder. Do not add them.
#
# ProtectKernelTunables — makes /proc/sysrq-trigger read-only, disabling the
#   forceful rung (ADR 0002).
#
# ProtectSystem=full or strict — full already makes /etc read-only. Strict
#   additionally makes /srv/watchgoose read-only, including log and state.
#
# ProtectKernelModules — unnecessary for the current workload; retained as a
#   conservative operational choice until the unit is tested on a scratch VM.
#
# Also deliberately not set, for the same class of reason:
#
# ProtectProc=invisible / ProcSubset=pid
#   — ProcSubset=pid strips /proc down to process directories, which removes
#   /proc/uptime and /proc/self/mountinfo. The daemon reads the first for the
#   uptime floor and the second to decide whether the volume is mounted
#   (ADR 0004). Both would silently become unreadable, and the failure mode of an
#   unreadable mountinfo is "repair the volume's contents while writing to the
#   root disk", which is worse than not repairing at all.
#
# PrivateDevices=true
#   — the daemon does not need /dev, but it needs execve of /usr/sbin/useradd
#   and friends, and there is no value in trading one new failure mode for
#   another on a unit that is this load-bearing.
#
# CapabilityBoundingSet / SystemCallFilter
#   — left unset deliberately. The daemon runs useradd, usermod, writes
#   sudoers.d, and writes the kernel sysrq trigger; narrowing the capability set or
#   the syscall filter for this workload means rediscovering the full set by
#   trial and error on the one machine where a mistake is unrecoverable. If
#   someone wants to narrow it, do it on a scratch machine and add the
#   reasoning to an ADR.

[Install]
WantedBy=multi-user.target
